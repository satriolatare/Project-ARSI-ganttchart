{
  "name": "manajemen-proyek-gantt",
  "version": "1.0.0",
  "description": "Aplikasi Manajemen Proyek berbasis Gantt Chart: task management, predecessors (FS/SS + lag), resource management, kalender kerja, jalur kritis, dan diagram PERT.",
  "private": true,
  "scripts": {
    "dev": "node serve.js",
    "test": "node test/logic.test.js && node test/ui.smoke.js",
    "test:logic": "node test/logic.test.js",
    "test:ui": "node test/ui.smoke.js",
    "start": "python3 -m http.server 8000 || python -m http.server 8000"
  },
  "keywords": ["gantt", "project-management", "critical-path", "pert", "cpm"],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^24.0.0"
  }
}
